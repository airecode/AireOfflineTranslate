<!--
  Option E — "Voice".
  An equaliser mirrored about the seam: this app is spoken into far more often than it is typed
  into, and bars stay legible at sizes where a bubble's tail has already turned to fuzz. Each bar
  is drawn as two rectangles so the halves can differ, which is the two panels again.

  Bars run x=22.5 to x=85.5 and the tallest reaches y=30.5, all within ~32 of centre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Far side of the conversation: above the seam, held back. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.72"
        android:pathData="M22.5,46.5 h6 v6 h-6 z M32,41.5 h6 v11 h-6 z M41.5,35.5 h6 v17 h-6 z M51,30.5 h6 v22 h-6 z M60.5,35.5 h6 v17 h-6 z M70,41.5 h6 v11 h-6 z M79.5,46.5 h6 v6 h-6 z" />

    <!-- Near side: below the seam, solid. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22.5,55.5 h6 v6 h-6 z M32,55.5 h6 v11 h-6 z M41.5,55.5 h6 v17 h-6 z M51,55.5 h6 v22 h-6 z M60.5,55.5 h6 v17 h-6 z M70,55.5 h6 v11 h-6 z M79.5,55.5 h6 v6 h-6 z" />
</vector>
